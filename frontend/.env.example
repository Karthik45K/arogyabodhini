# .env.example — copy this to .env and fill in your values
# DO NOT commit .env to version control

# ── Frontend (Vite) ──────────────────────────────────────────
# App ID from ZEGOCLOUD Console (public, safe for frontend)
VITE_ZEGO_APP_ID=YOUR_APP_ID_HERE

# Backend API URL (Express server that generates secure tokens)
VITE_API_BASE_URL=http://localhost:5000

# ── Backend (server/.env) ─────────────────────────────────────
# Copy the lines below into server/.env
# The Server Secret MUST stay backend-only — never expose it in frontend code.
MONGODB_URI=your_mongodb_connection_string_here
ZEGO_APP_ID=your_app_id_here
ZEGO_SERVER_SECRET=your_server_secret_here
ZEGO_TOKEN_EXPIRY_SECONDS=3600
DOCTOR_DEFAULT_PASSWORD=your_development_password_here
